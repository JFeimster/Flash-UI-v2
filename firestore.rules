rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // === Global Helper Functions ===
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // === Blueprint Validations ===
    function isValidUser(data, userId) {
      return data.id == userId
        && data.id == request.auth.uid
        && ('createdAt' in data && data.createdAt is string && data.createdAt.size() <= 100)
        && (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 150))
        && (!('userApiKey' in data) || data.userApiKey == null || (data.userApiKey is string && data.userApiKey.size() <= 200));
    }

    function isValidSession(data, userId) {
      return data.id is string && data.id.size() <= 128
        && data.userId == userId
        && data.userId == request.auth.uid
        && data.prompt is string && data.prompt.size() <= 10000
        && data.timestamp is number
        && data.artifacts is list
        && (!('contextUrl' in data) || data.contextUrl == null || (data.contextUrl is string && data.contextUrl.size() <= 2083))
        && (!('attachments' in data) || data.attachments is list);
    }

    function isValidArtifact(data) {
      return data.id is string && data.id.size() <= 128
        && data.styleName is string && data.styleName.size() <= 256
        && data.html is string && data.html.size() <= 1000000 // Firestore document is max 1MB
        && data.status is string && (data.status == 'streaming' || data.status == 'complete' || data.status == 'error');
    }

    // === Firestore Collection Paths ===

    // 1. Users Profile & Api Keys
    match /users/{userId} {
      allow get, delete: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming(), userId);
      allow update: if isOwner(userId) && isValidUser(incoming(), userId)
        && (!existing().keys().hasAll(['createdAt']) || incoming().createdAt == existing().createdAt);
    }

    // 2. Chat/Generations Sessions
    match /users/{userId}/sessions/{sessionId} {
      allow list: if isOwner(userId);
      allow get, delete: if isOwner(userId) && isValidId(sessionId);
      allow create: if isOwner(userId) && isValidId(sessionId) && isValidSession(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(sessionId) && isValidSession(incoming(), userId);
    }

    // 3. Saved Artifacts (Library)
    match /users/{userId}/savedArtifacts/{artifactId} {
      allow list: if isOwner(userId);
      allow get, delete: if isOwner(userId) && isValidId(artifactId);
      allow create: if isOwner(userId) && isValidId(artifactId) && isValidArtifact(incoming());
      allow update: if isOwner(userId) && isValidId(artifactId) && isValidArtifact(incoming());
    }
  }
}
